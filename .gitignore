# Virtual environment - never commit this, it's platform-specific and huge.
# Recreate it on any new machine with:
#   python -m venv venv
#   venv\Scripts\pip install -r requirements.txt
backend/venv/

# Local SQLite database - contains real audit history and session data.
# Production should run migrate against its own fresh file, not this one.
backend/db.sqlite3

